[Desktop Entry]
Type=Application
Name=OmniZip
GenericName=Archive Manager
GenericName[zh_CN]=压缩包管理器
GenericName[zh_TW]=壓縮檔管理員
GenericName[ja]=アーカイブマネージャー
Comment=Create, extract, convert and mount archives
Comment[zh_CN]=创建、解压、转换和挂载压缩包
Comment[zh_TW]=建立、解壓縮、轉換和掛載壓縮檔
Comment[ja]=アーカイブの作成・展開・変換・マウント
Exec=omnizip-desktop %F
Icon=omnizip-desktop
Terminal=false
StartupNotify=true
StartupWMClass=omnizip-desktop
Categories=Utility;Archiving;Compression;
Keywords=zip;7z;rar;tar;archive;extract;compress;mount;
MimeType=application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lz4-compressed-tar;application/gzip;application/x-gzip;application/x-bzip;application/x-bzip2;application/x-xz;application/x-lzma;application/zstd;application/x-zstd;application/x-lz4;
