<?xml version="1.0" encoding="utf-8"?>
<!--
  OmniZip MSIX manifest template (docs/07-shell-integration.md §3, docs/10-build-release.md §3).
  pack.ps1 fills in $VERSION$, $PUBLISHER$ and $ARCH$, stages the release binaries and calls
  makeappx. Compared with the NSIS installer, the package adds the Windows 11 top-level
  context menu (windows.fileExplorerContextMenus), served by the same COM class that the
  classic menu uses ({6F1E7A52-3C4B-4D1E-9A7F-0B2C3D4E5F00}, crates/omnizip-shell-win).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop4 desktop5 desktop6 virtualization com rescap">

  <Identity Name="OmniZip.OmniZip" Publisher="$PUBLISHER$" Version="$VERSION$" ProcessorArchitecture="$ARCH$" />

  <Properties>
    <DisplayName>OmniZip</DisplayName>
    <PublisherDisplayName>OmniZip Contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Archive manager: create, extract, test, convert and mount archives.</Description>
    <!-- The configuration (with the user's theme folder) and data directories are the real ones,
         as with the NSIS install: packaged apps otherwise get new AppData folders redirected to
         a private copy that File Explorer cannot open ("Open theme folder" failed on a fresh
         install). Windows 11 exempts just these two folders; Windows 10 only knows the switch
         for all of AppData. Both need the unvirtualizedResources capability. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\OmniZip</virtualization:ExcludedDirectory>
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\OmniZip</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-cn" />
    <Resource Language="zh-tw" />
    <Resource Language="ja-jp" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="OmniZip" Executable="omnizip-desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OmniZip"
        Description="Archive manager"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Archives open in OmniZip (the user still confirms the default app in Settings). -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="omnizip.archive">
            <uap:DisplayName>Archive</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.zipx</uap:FileType>
              <uap:FileType>.7z</uap:FileType>
              <uap:FileType>.rar</uap:FileType>
              <uap:FileType>.tar</uap:FileType>
              <uap:FileType>.tgz</uap:FileType>
              <uap:FileType>.tbz2</uap:FileType>
              <uap:FileType>.txz</uap:FileType>
              <uap:FileType>.tzst</uap:FileType>
              <uap:FileType>.gz</uap:FileType>
              <uap:FileType>.bz2</uap:FileType>
              <uap:FileType>.xz</uap:FileType>
              <uap:FileType>.zst</uap:FileType>
              <uap:FileType>.lz4</uap:FileType>
              <uap:FileType>.br</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Windows 11 top-level context menu for files and folders. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="OmniZip" Clsid="6F1E7A52-3C4B-4D1E-9A7F-0B2C3D4E5F00" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="OmniZip" Clsid="6F1E7A52-3C4B-4D1E-9A7F-0B2C3D4E5F00" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="OmniZip context menu">
              <com:Class Id="6F1E7A52-3C4B-4D1E-9A7F-0B2C3D4E5F00" Path="omnizip_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>

    <!-- `omnizip` on the command line, through an app execution alias. -->
    <Application Id="OmniZipCli" Executable="omnizip.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OmniZip CLI"
        Description="OmniZip command line"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="omnizip.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="omnizip.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
