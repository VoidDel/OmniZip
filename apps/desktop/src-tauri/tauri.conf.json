{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniZip",
  "mainBinaryName": "omnizip-desktop",
  "version": "0.1.0",
  "identifier": "app.omnizip.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "OmniZip Contributors",
    "copyright": "Copyright (c) 2026 OmniZip Contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Archive manager: create, extract, test and convert archives",
    "longDescription": "OmniZip is a cross-platform archive manager for ZIP, 7z, TAR, RAR and more, with a modern interface, many languages and themes, and file-manager integration.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "zip"
        ],
        "name": "OmniZip.zip",
        "description": "ZIP archive",
        "role": "Editor",
        "mimeType": "application/zip"
      },
      {
        "ext": [
          "zipx"
        ],
        "name": "OmniZip.zipx",
        "description": "ZIPX archive",
        "role": "Editor",
        "mimeType": "application/zip"
      },
      {
        "ext": [
          "7z"
        ],
        "name": "OmniZip.7z",
        "description": "7z archive",
        "role": "Editor",
        "mimeType": "application/x-7z-compressed"
      },
      {
        "ext": [
          "rar"
        ],
        "name": "OmniZip.rar",
        "description": "RAR archive",
        "role": "Viewer",
        "mimeType": "application/vnd.rar"
      },
      {
        "ext": [
          "tar"
        ],
        "name": "OmniZip.tar",
        "description": "TAR archive",
        "role": "Editor",
        "mimeType": "application/x-tar"
      },
      {
        "ext": [
          "tgz"
        ],
        "name": "OmniZip.tgz",
        "description": "TAR.GZ archive",
        "role": "Editor",
        "mimeType": "application/x-compressed-tar"
      },
      {
        "ext": [
          "tbz2"
        ],
        "name": "OmniZip.tbz2",
        "description": "TAR.BZ2 archive",
        "role": "Editor",
        "mimeType": "application/x-bzip2-compressed-tar"
      },
      {
        "ext": [
          "txz"
        ],
        "name": "OmniZip.txz",
        "description": "TAR.XZ archive",
        "role": "Editor",
        "mimeType": "application/x-xz-compressed-tar"
      },
      {
        "ext": [
          "tzst"
        ],
        "name": "OmniZip.tzst",
        "description": "TAR.ZST archive",
        "role": "Editor",
        "mimeType": "application/x-zstd-compressed-tar"
      },
      {
        "ext": [
          "gz"
        ],
        "name": "OmniZip.gz",
        "description": "GZ compressed file",
        "role": "Editor",
        "mimeType": "application/gzip"
      },
      {
        "ext": [
          "bz2"
        ],
        "name": "OmniZip.bz2",
        "description": "BZ2 compressed file",
        "role": "Editor",
        "mimeType": "application/x-bzip2"
      },
      {
        "ext": [
          "xz"
        ],
        "name": "OmniZip.xz",
        "description": "XZ compressed file",
        "role": "Editor",
        "mimeType": "application/x-xz"
      },
      {
        "ext": [
          "zst"
        ],
        "name": "OmniZip.zst",
        "description": "ZST compressed file",
        "role": "Editor",
        "mimeType": "application/zstd"
      },
      {
        "ext": [
          "lz4"
        ],
        "name": "OmniZip.lz4",
        "description": "LZ4 compressed file",
        "role": "Editor",
        "mimeType": "application/x-lz4"
      },
      {
        "ext": [
          "br"
        ],
        "name": "OmniZip.br",
        "description": "Brotli compressed file",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English",
          "Japanese"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "zh-CN",
          "en-US"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
