{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window, the mini progress windows and the standalone dialog windows opened from the file manager. The UI never touches the file system directly; everything goes through OmniZip commands (docs/09-security.md §7).",
  "windows": ["main", "mini-*", "shell-*"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:window:allow-theme",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
