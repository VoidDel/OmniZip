<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Embedded in development builds on macOS (`pnpm dev`; tauri-codegen embeds the Info.plist next to
  tauri.conf.json). The languages of the interface, so that macOS draws its own parts of the app
  (open and save panels, the application menu) in the system language rather than in English.
  Bundles use platform/macos/Info.plist, which has the same list.
-->
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>ja</string>
	</array>
</dict>
</plist>
