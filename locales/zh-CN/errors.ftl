error-io = 读写错误 { $path }
error-not-found = 找不到文件：{ $path }
error-permission-denied = 没有权限：{ $path }
error-disk-full = 磁盘空间不足，无法写入 { $path }
error-already-exists = 已存在：{ $path }
error-unknown-format = 不是可识别的压缩包：{ $path }
error-unsupported-format = 当前版本无法打开 { $format } 格式
error-unsupported-operation = { $format } 格式不支持此操作（{ $operation }）
error-unsupported-method = 不支持的压缩或加密方法 { $method }
error-corrupt = 压缩包已损坏：{ $path }
error-crc-mismatch = 校验和不匹配，数据已损坏：{ $path }
error-wrong-password = 密码错误：{ $path }
error-password-required = { $path } 已加密，需要密码
error-truncated = 压缩包意外结束：{ $path }
error-missing-volume = 缺少分卷：{ $path }
error-path-escape = 已拒绝路径越出目标目录的条目：{ $path }
error-compression-bomb = 压缩包会膨胀 { $ratio } 倍至 { $size } 字节，已拒绝（疑似压缩炸弹）。如需继续请使用 --allow-high-ratio
error-too-many-entries = 压缩包声明的条目过多（{ $count }）
error-unsafe-link = 已拒绝指向目标目录之外的链接：{ $path }
error-cancelled = 已取消
error-invalid-argument = 参数无效：{ $detail }
error-missing-dependency = 缺少此格式所需的可选组件
error-internal = 内部错误。请附上 `omnizip --version` 的输出反馈给我们
