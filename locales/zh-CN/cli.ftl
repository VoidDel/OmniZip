cli-about = 创建、解压、测试和转换压缩包（ZIP、7z、TAR、RAR、gz、xz、zst 等）
cmd-extract = 解压（保留目录结构，默认智能解压）
cmd-flat = 解压到单层目录（不保留路径）
cmd-create = 创建压缩包，或向已有的 ZIP 添加文件
cmd-list = 列出压缩包内容
cmd-test = 测试压缩包完整性
cmd-info = 显示压缩包信息
cmd-delete = 从 ZIP 中删除条目
cmd-rename = 重命名 ZIP 中的条目
cmd-convert = 将压缩包转换为其他格式
cmd-formats = 列出支持的格式与能力
cmd-completions = 输出 Shell 补全脚本
cmd-gui = 打开图形界面
cmd-manpages = 将手册页写入目录

arg-quiet = 只输出错误
arg-verbose = 输出更多细节（重复使用可输出调试信息）
arg-json = 输出机器可读的 JSON
arg-porcelain = 输出供脚本使用的稳定制表符分隔格式
arg-progress = 进度显示方式
arg-color = 何时使用颜色
arg-lang = 输出语言（zh-CN、zh-TW、en-US、ja-JP）
arg-no-input = 从不提问，直接失败
arg-yes = 对所有问题回答“是”，并覆盖已有文件
arg-threads = 工作线程数（0 = 自动）
arg-archives = 要处理的压缩包（“-” 表示标准输入）
arg-archive = 压缩包文件
arg-output = 输出目录
arg-path = 条目路径的输出方式
arg-each = 每个压缩包始终解压到各自的文件夹
arg-overwrite = 目标文件已存在时的处理方式
arg-password = 密码；不带值时提示输入
arg-password-file = 从文件读取密码
arg-password-env = 从环境变量读取密码
arg-include = 只处理匹配此通配符的条目
arg-exclude = 跳过匹配此通配符的条目
arg-encoding = 旧压缩包的文件名编码（auto、gb18030、big5、shift_jis、cp437 等）
arg-stdout = 将文件内容写到标准输出
arg-no-smart = 不创建以压缩包命名的文件夹
arg-keep-broken = 保留校验失败的文件
arg-allow-high-ratio = 即使膨胀比可疑也继续解压（压缩炸弹检查）
arg-strip-unsafe-paths = 去掉 “..” 和绝对路径前缀，而不是拒绝这些条目
arg-paths = 要添加的文件和文件夹
arg-format = 压缩包格式（zip、7z、tar、tar.gz、tar.xz、tar.zst、gz、xz、zst 等）
arg-level = 压缩级别：store、fastest、fast、normal、better、best、ultra 或 0-9
arg-method = 压缩方法（Deflate、LZMA2、BZip2、Zstandard 等）
arg-solid = 固实压缩（7z）
arg-no-solid = 关闭固实压缩（7z）
arg-compress-all = 照片、视频、压缩包等已压缩的文件也重新压缩（默认 ZIP 与 7z 直接存储它们）
arg-encrypt-headers = 同时加密文件名（7z）
arg-volume = 按此大小分卷（如 100m、4g）
arg-exclude-from = 从文件读取排除规则，每行一个
arg-follow-symlinks = 打包符号链接指向的内容
arg-skip-hidden = 跳过隐藏文件和文件夹
arg-comment = 压缩包注释（ZIP）
arg-delete-source = 成功后删除源文件
arg-force = 目标压缩包已存在时覆盖
arg-tree = 以树形显示条目
arg-globs = 只列出匹配这些通配符的条目
arg-entries = 要删除的条目
arg-from = 当前条目路径
arg-to-name = 新条目路径
arg-to = 目标格式
arg-out-dir = 转换结果的输出目录
arg-shell = 要生成补全的 Shell
arg-dir = 输出目录
arg-files = 要打开的文件

prompt-password = { $archive } 的密码：
prompt-password-retry = 密码错误，请重新输入（{ $archive }）：
prompt-conflict = { $path } 已存在（{ $existing } → { $incoming }）。[o]覆盖 [s]跳过 [r]重命名，[O]全部覆盖 [S]全部跳过，[q]退出：
prompt-high-ratio = { $archive } 将膨胀 { $ratio } 倍至 { $size }。是否继续？[y/N]：

warn-prefix = 警告
warn-password-argument = 命令行中的密码对其他程序可见。建议使用 -p（交互输入）或 --password-file。
warn-entry = { $path }：{ $message }
summary-extracted = 已解压 { $files } 个文件（{ $size }）到 { $dest }，用时 { $elapsed }
summary-created = 已创建 { $archive }（{ $size }，{ $files } 个文件），用时 { $elapsed }
summary-volumes = 共写入 { $count } 个分卷
summary-tested = { $archive }：{ $files } 个文件正常（{ $size }）
summary-tested-errors = { $archive }：{ $files } 个文件中有 { $errors } 个已损坏
summary-updated = 已更新 { $archive }
summary-deleted = 已从 { $archive } 删除 { $count } 个条目
summary-renamed = 已重命名 { $from } → { $to }
summary-converted = { $src } → { $dest }（{ $size }）
summary-list = { $files } 个文件，{ $dirs } 个文件夹，{ $size }（压缩后 { $packed }）
summary-skipped = 跳过了 { $count } 项
summary-warnings = { $count } 条警告
hint-single-file = { $format } 只能容纳一个文件。如需打包多个文件，请使用 --format tar.{ $format }。
hint-infer-format = 无法从“{ $name }”判断格式。请添加扩展名或使用 --format。
gui-not-found = 在本程序旁边找不到 OmniZip 桌面应用。

